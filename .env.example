# Exemplos de configuração. Nunca adicionar valores reais de produção ao GitHub.

NEXT_PUBLIC_APP_NAME=Sistema Lojasaph

# URL pública da aplicação.
# - Production: domínio HTTPS canônico (ou VERCEL_PROJECT_PRODUCTION_URL quando disponível).
# - Preview na Vercel usa VERCEL_URL automaticamente e ignora esta variável para callbacks.
# - Development deve permanecer local.
NEXT_PUBLIC_APP_URL=

# Identidade explícita opcional do runtime: development | preview | production.
# Na Vercel, quando definida, DEVE coincidir com VERCEL_ENV; divergência falha fechado.
LOJASAPH_APP_ENV=

# Supabase — preencher apenas no ambiente local/hosting conectado.
# A publishable key pode ser usada pelo cliente somente para operações protegidas por RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Referências de projeto NÃO são secrets, mas servem como guardrail de identidade.
# Production pode fixar sua ref; Preview/Development hospedados só são liberados quando
# sua ref própria e a ref de Production estiverem ambas configuradas e forem distintas.
LOJASAPH_PRODUCTION_SUPABASE_REF=
LOJASAPH_PREVIEW_SUPABASE_REF=
LOJASAPH_DEVELOPMENT_SUPABASE_REF=

# Server-only. Nunca prefixar com NEXT_PUBLIC_ e nunca enviar ao navegador.
# Necessária apenas para rotinas administrativas explícitas, como o bootstrap inicial.
SUPABASE_SECRET_KEY=

# Fora de Production, o admin client permanece bloqueado mesmo se o secret existir.
# Só habilitar em backend isolado e com aprovação explícita.
LOJASAPH_ALLOW_NON_PRODUCTION_ADMIN=false

# Bootstrap do primeiro owner. Remover/desabilitar após a inicialização.
# O e-mail precisa corresponder exatamente ao usuário autenticado.
LOJASAPH_BOOTSTRAP_OWNER_EMAIL=

# Opcional quando existe exatamente uma Organization ativa; obrigatório se houver zero ou múltiplas.
LOJASAPH_BOOTSTRAP_ORGANIZATION_ID=
