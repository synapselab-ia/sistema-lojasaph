# Exemplos de configuração. Nunca adicionar valores reais de produção ao GitHub.

NEXT_PUBLIC_APP_NAME=Sistema Lojasaph

# Supabase — preencher apenas no ambiente local/hosting quando houver projeto conectado.
# A publishable key pode ser usada pelo cliente somente para operações protegidas por RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Nunca prefixar com NEXT_PUBLIC_ e nunca enviar ao navegador.
SUPABASE_SECRET_KEY=
